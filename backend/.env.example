# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=words

# GitHub OAuth 配置
# 在 https://github.com/settings/developers 创建 OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# 自定义 OAuth2 配置
OAUTH_NAME=SSO
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_AUTH_ENDPOINT=http://localhost:8000/oauth2/authorize
OAUTH_TOKEN_ENDPOINT=http://localhost:8000/oauth2/token
OAUTH_USERINFO_ENDPOINT=http://localhost:8000/oauth2/userinfo
OAUTH_SCOPES=openid profile email

# JWT 配置
JWT_SECRET_KEY=your-secure-random-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
